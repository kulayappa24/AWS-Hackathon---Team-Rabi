{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://sbg-member-portal-env.eba-e828ausa.ap-south-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/ask",
      "destination": "http://sbg-member-portal-env.eba-e828ausa.ap-south-1.elasticbeanstalk.com/ask"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
