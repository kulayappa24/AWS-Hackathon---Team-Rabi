# ========================================================
# Student Builder Groups — Club Member Portal Environment Variables
# Copy to .env for local runtime configuration
# ========================================================

# Server Configuration
PORT=8080
SERVER_PORT=8080

# Spring Profiles: 'default' (PostgreSQL) or 'local' (Embedded DB for zero-dependency testing)
SPRING_PROFILES_ACTIVE=default

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sbg_member_portal
DB_USER=sbg_admin
DB_PASSWORD=sbg_secure_password_2026
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sbg_member_portal
SPRING_DATASOURCE_USERNAME=sbg_admin
SPRING_DATASOURCE_PASSWORD=sbg_secure_password_2026

# JWT Security Configuration (Never commit production secrets)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_RESET_TOKEN_EXPIRATION_MINUTES=30

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Document Ingestion Configuration
DOCUMENTS_DIRECTORY_PATH=../documents

# AI Provider Configuration: 'local' (Local Grounded Engine) or 'bedrock' (Amazon Bedrock)
AI_PROVIDER=local
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Email Service (Supports real SMTP e.g. Gmail App Password, Brevo, Amazon SES)
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@studentbuilders.edu
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
# AWS SES Production credentials
# AWS_SES_FROM_EMAIL=noreply@studentbuilders.edu

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api
